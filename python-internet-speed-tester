import tkinter as tk
from tkinter import messagebox
import speedtest
import threading

def run_speed_test():
    test_button.config(state="disabled")
    status_label.config(text="Testing internet speed...")
    download_label.config(text="Download: -- Mbps")
    upload_label.config(text="Upload: -- Mbps")
    ping_label.config(text="Ping: -- ms")

    threading.Thread(target=perform_test, daemon=True).start()

def perform_test():
    try:
        st = speedtest.Speedtest()
        st.get_best_server()

        ping = st.results.ping
        download = st.download() / 1_000_000
        upload = st.upload() / 1_000_000

        root.after(
            0, show_results, download, upload, ping
        )

    except Exception as error:
        root.after(0, show_error, str(error))

def show_results(download, upload, ping):
    download_label.config(
        text=f"Download: {download:.2f} Mbps"
    )
    upload_label.config(
        text=f"Upload: {upload:.2f} Mbps"
    )
    ping_label.config(text=f"Ping: {ping:.2f} ms")
    status_label.config(text="Speed test completed!")
    test_button.config(state="normal")

def show_error(error):
    status_label.config(text="Speed test failed.")
    test_button.config(state="normal")
    messagebox.showerror(
        "Error",
        f"Unable to complete speed test.\n{error}"
    )

root = tk.Tk()
root.title("Internet Speed Tester")
root.geometry("400x330")
root.resizable(False, False)

tk.Label(
    root,
    text="Internet Speed Tester",
    font=("Arial", 18, "bold")
).pack(pady=15)

download_label = tk.Label(
    root, text="Download: -- Mbps", font=("Arial", 12)
)
download_label.pack(pady=8)

upload_label = tk.Label(
    root, text="Upload: -- Mbps", font=("Arial", 12)
)
upload_label.pack(pady=8)

ping_label = tk.Label(
    root, text="Ping: -- ms", font=("Arial", 12)
)
ping_label.pack(pady=8)

status_label = tk.Label(
    root, text="Ready to test", font=("Arial", 10)
)
status_label.pack(pady=8)

test_button = tk.Button(
    root,
    text="Start Speed Test",
    command=run_speed_test,
    font=("Arial", 12),
    padx=10,
    pady=5
)
test_button.pack(pady=10)

root.mainloop()
